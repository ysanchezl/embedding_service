# Secrets and deploy paths only. Models live in config/models.json and the
# service settings in config/service.json.

# Keys that clients must send as 'Authorization: Bearer <key>' (comma-separated, min 16 chars each).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The service will not start without it.
SERVICE_API_KEYS=

# API key for the default model (openrouter-bge-m3). The variable name comes from
# "api_key_env" in config/models.json: add one variable per API model you use.
OPENROUTER_API_KEY=

# Only needed if you use the groq-nomic model.
GROQ_API_KEY=

# Hugging Face token: only needed to download private or gated local models.
HF_TOKEN=

# Optional overrides
# CONFIG_DIR=config
# MODEL_DIR=./models     # overrides model_dir from config/service.json
# DISABLE_AUTH=true      # local development only: turns authentication off
