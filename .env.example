MODEL_NAME=intfloat/multilingual-e5-small
MODEL_DIR=./models
# E5 models need these prefixes; leave empty for models that do not (bge-m3, gte...)
QUERY_PREFIX="query: "
PASSAGE_PREFIX="passage: "
NORMALIZE=true
BATCH_SIZE=32
# CHUNK_TOKENS=   (empty = use the model's max_seq_length)
CHUNK_OVERLAP_RATIO=0.12
# Request limits (413 if exceeded) and job queue (429 if full)
MAX_DOCUMENTS=100
MAX_DOCUMENT_CHARS=2000000
MAX_TOTAL_CHARS=10000000
MAX_PENDING_JOBS=20
JOB_TTL_SECONDS=3600
TRUST_REMOTE_CODE=false

HF_TOKEN=
